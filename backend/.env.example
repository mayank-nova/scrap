# Optional. Without a key the app still works; the scanner falls back to a colour-based guess.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# SECRET_KEY=change-me   (signs login tokens; auto-generated into backend/.secret if unset)
# SEED_DEMO=0            (set to 0 to skip creating the demo / collector accounts)
# GOOGLE_CLIENT_ID=      (Google sign-in: create an OAuth Web client in Google Cloud and add your site URL as an authorised origin)
# YOUTUBE_API_KEY=       (tutorial videos play inside the site; without it the links open YouTube instead)
# ADMIN_USERNAME=admin   (creates/updates the admin account on startup; password needs 8+ characters)
# ADMIN_PASSWORD=
# NOTIFY_RADIUS_KM=10    (collectors with a saved location inside this distance are told about new requests)
